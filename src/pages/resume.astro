---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
const base = '/vikhram';

const experiences = [
  {
    period: 'Feb 2026 - Present',
    role: 'Volunteer',
    org: 'NextGen Biology Newsletter',
    location: 'Visakhapatnam · Remote',
    description: 'Dynamic support, content editing and proofreading for a biology-focused newsletter.',
  },
  {
    period: 'Feb 2024 - Jul 2024',
    role: 'Intern',
    org: 'Sri Projects',
    location: 'Chennai · On-Site',
    description: 'Biogas yields of various substrates, VBA Macros involving various conditions/real-time scenarios from field data, Biogas Output Mass Balance Calculations for Biogas Plants. Basics of AFT Fathom for fluid dynamics analysis. Stress Analysis for Bio-related plants using CAESAR II.',
  },
  {
    period: 'Feb 2024 - Jul 2024',
    role: 'Virtual Intern',
    org: 'NyBerMan Bioinformatics',
    location: 'Orleans, France · Remote',
    description: 'Analyzing data from COSMIC database for Breast cancer mutations. Molecular Docking to identify suitable drugs effective against specific mutations.',
  },
];

const education = [
  {
    period: 'Aug 2024 - Jul 2026',
    degree: 'M. Tech',
    field: 'Nanobiotechnology',
    school: 'Amrita School of Nanosciences and Molecular Medicine',
    location: 'Kochi, India',
    gpa: '9.48/10',
    description: 'Focused on nanomedicine, biomaterials, targeted drug delivery systems, polymer synthesis and characterization.',
  },
  {
    period: 'Dec 2024 - May 2026',
    degree: 'M. S',
    field: 'Immunobiology',
    school: 'University of Arizona, College of Medicine',
    location: 'Tucson, USA',
    gpa: '4/4',
    description: 'Advanced concepts in immune system function, host-pathogen interactions, and translational immunology.',
  },
  {
    period: 'Jul 2020 - Jun 2024',
    degree: 'B. Tech',
    field: 'Biotechnology',
    school: 'Saveetha Institute of Medical and Technical Sciences',
    location: 'Chennai, India',
    gpa: '9/10',
    description: 'Comprehensive curriculum covering molecular biology, immunology, and bioprocess engineering. Best Outgoing Student 2024.',
  },
];

const skillGroups = [
  {
    title: 'Characterization',
    icon: 'bi-search',
    skills: ['SEM', 'DLS/ZETA', 'XRD', 'H-NMR', 'FTIR'],
  },
  {
    title: 'Bioinformatics',
    icon: 'bi-cpu',
    skills: ['Molecular Docking', 'PyMOL', 'Discovery Studio', 'Binding Site Prediction', 'BLAST', 'MD Simulation', 'Linux'],
  },
  {
    title: 'Polymer Chemistry',
    icon: 'bi-droplet',
    skills: ['Linear Polymer Synthesis', 'Carothers Equation'],
  },
  {
    title: 'Gene Delivery',
    icon: 'bi-diagram-3',
    skills: ['Polyplex Systems', 'Core-Shell Systems'],
  },
  {
    title: 'Molecular Biology',
    icon: 'bi-water',
    skills: ['DNA/RNA Extraction', 'Plasmid Isolation', 'TLC', 'SDS PAGE', 'ELISA', 'ROS/Toxicity Assays'],
  },
  {
    title: 'Cell Culture',
    icon: 'bi-grid',
    skills: ['L929', 'RAW 264.7', 'HEK 293', 'PBMC Isolation', 'Transfection', 'In vitro Assays'],
  },
  {
    title: 'Statistical / Data',
    icon: 'bi-bar-chart',
    skills: ['Origin Lab', 'SPSS', 'GraphPad PRISM', 'Tableau'],
  },
  {
    title: 'Industrial Biotech',
    icon: 'bi-gear',
    skills: ['Biogas Mass Balance', 'PFD', 'AFT Arrow', 'CAESAR II'],
  },
  {
    title: 'Documentation',
    icon: 'bi-file-text',
    skills: ['MS Office Suite', 'LaTeX', 'Markdown', 'VBA Macros'],
  },
  {
    title: 'Metagenomics',
    icon: 'bi-diagram-3',
    skills: ['cfDNA Analysis', 'Pathogen Identification', 'AMR Profiling', 'KMA', 'ResFinder', 'CARD', 'Bowtie2', 'fastp', 'Docker'],
  },
];

const projects = [
  {
    title: 'PhD Research: Metagenomic cfDNA for Sepsis Detection in Liver Transplant Recipients',
    period: 'Aug 2026 - Present',
    description: 'ANRF-funded project at ASNSMM under Dr. Lalitha Biswas. Evaluating clinical utility of metagenomic cfDNA sequencing for early and accurate sepsis detection in liver transplant recipients.',
    bullets: [
      'cfDNA extraction & library prep optimization from liver transplant plasma',
      'Host depletion (Bowtie2/GRCh38) + pathogen ID (KMA + ResFinder/CARD)',
      'AMR gene & point mutation profiling for antimicrobial resistance',
      'Clinical cohort: liver transplant recipients with suspected sepsis',
      'Rapid <24h reporting pipeline for clinical decision support'
    ],
  },
  {
    title: "Master's Thesis",
    period: 'Jun 2025 - Jul 2026 (Completed)',
    description: 'A Novel Non-Viral Gene Vector: PBAE based Core-Shell Nanoparticle System for Gene Delivery',
    bullets: ['Synthesis of PBAE, Troubleshooting approaches and Optimization', 'Core-shell system design, Cell Culture, GFP-Transfection studies'],
  },
  {
    title: "Bachelor's Thesis",
    period: 'May 2024',
    description: 'Examining the Therapeutic effects of Camphene Conjugated with Zinc Oxide Nanoparticles on Zebrafish Larvae',
    bullets: ['Developmental Toxicity Studies in Zebrafish in-vivo model', 'Neurotoxicity analysis using locomotory parameters', 'ROS Enhancement Levels using GPx and GST parameters', 'Lipid Peroxidation level analysis using DCFH-DA staining'],
  },
  {
    title: 'Ammo Mist',
    period: 'Oct 2023 - Mar 2024',
    description: 'Ammonia sensor for Aquariums',
    bullets: ['IoT module for detecting dissolved ammonia', 'Non-electrode-based detection method'],
  },
  {
    title: 'Clin Mist',
    period: 'Jul 2022 - Dec 2022',
    description: 'Natural Surface Disinfectant',
    bullets: ['Novel disinfectant using terpinen-4-ol from Green tea extract'],
  },
];

const courses = [
  { name: 'Fundamentals in Biotechnology and Genetics', issuer: 'Alison (NPTEL)', date: 'Jun 2024' },
  { name: 'Google Business Intelligence', issuer: 'Google (Coursera)', date: 'Apr 2024' },
  { name: 'Drug Discovery', issuer: 'UC San Diego (Coursera)', date: 'Mar 2024' },
  { name: 'Introduction to the Biology of Cancer', issuer: 'Johns Hopkins University (Coursera)', date: 'Mar 2024', note: 'With Honors' },
  { name: 'Drug Delivery: Principles and Engineering', issuer: 'IISc Bangalore (NPTEL)', date: 'Oct 2022' },
];

const conferences = [
  { name: 'Virtual Winter School on Computational Chemistry, GROMACS', date: 'Jan 2026', detail: 'Training modules led by GROMACS Team for molecular docking simulations' },
  { name: '8th Indian Myeloma Congress, IMAGe', date: 'Jan 2026', detail: 'Workshop on Flow Cytometry for MRD, Gating strategies, Flow Cytometry vs NGS' },
  { name: 'Workshop on Electrospinning for Nanofibre Production', date: 'May 2024', detail: 'Sathyabama, Chennai' },
  { name: '14th International Conference on Science & Innovative Engineering', date: 'Apr 2024', detail: 'Paper Presentation: "Evaluating the Pharmacological Profile of Novel Drug Camphene conjugated with Zinc Oxide Nanoparticles using Zebrafish Larvae model"' },
  { name: 'Workshop on Biomass Fermentation and Distillation', date: 'May 2024', detail: 'Sathyabama, Chennai' },
  { name: 'Workshop on Biomimetic Scaffolds Fabrication', date: 'Jun 2021', detail: 'Binghamton University' },
];

const awards = [
  { title: 'GATE Biotechnology 2026 - Qualified', org: 'IIT Guwahati', date: 'Mar 2026' },
  { title: 'Institute Scholarship', org: 'ASNSMM, Amrita Vishwa Vidyapeetham', date: 'Jul 2024 - Present', detail: '2nd Rank Holder of Nanobiotechnology Department' },
  { title: 'Best Outgoing Student', org: 'SSE, SIMATS University', date: 'Nov 2024', detail: 'Best Outgoing Student of 2024 Batch, First mark in Plant Biotechnology and Molecular Biology' },
];

const chess = [
  { title: 'VALOR represented team Zelos, ASNSMM', place: '1st Place', date: 'Mar 2025' },
  { title: 'SIMAM represented team Samudra, SIMATS', place: '1st Place', date: 'May 2022' },
  { title: 'CBSE Nationals represented Jawahar Vidyalaya', place: '2nd Runner Up', date: 'Nov 2014' },
  { title: 'CBSE Zonals represented Jawahar Vidyalaya', place: '1st Runner Up', date: 'Oct 2014' },
];
---

<Layout title="Vikhram Ravi - Resume">
  <Nav />
  <main class="flex-1">
    <div class="max-w-5xl mx-auto px-6 py-16">
      <!-- Header -->
      <div class="text-center mb-16 reveal">
        <h1 class="text-4xl md:text-5xl font-extrabold mb-4">
          <span class="text-gradient">Resume</span>
        </h1>
        <a href={`${base}/assets/Vikhram_R_CV.pdf`} target="_blank"
           class="inline-flex items-center gap-2 px-6 py-3 bg-primary hover:bg-primary-dark text-white font-bold rounded-2xl transition-all duration-200 hover:shadow-lg hover:shadow-primary/20">
          <i class="bi bi-download"></i>
          Download CV
        </a>
      </div>

      <!-- Experience -->
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center">
            <i class="bi bi-briefcase text-white"></i>
          </div>
          <h2 class="text-2xl font-extrabold">Experience</h2>
        </div>
        <div class="space-y-6">
          {experiences.map((exp, i) => (
            <div class="reveal card-hover p-6 rounded-2xl bg-white dark:bg-dark-card border border-gray-100 dark:border-dark-border" style={`animation-delay: ${i * 0.1}s`}>
              <div class="flex flex-col md:flex-row gap-6">
                <div class="md:w-48 shrink-0">
                  <div class="bg-gray-50 dark:bg-dark-bg rounded-xl p-4 text-center md:text-left">
                    <div class="text-primary dark:text-primary-light font-bold text-sm">{exp.period}</div>
                    <div class="font-bold mt-2">{exp.role}</div>
                    <div class="text-sm text-gray-500 dark:text-gray-400">{exp.org}</div>
                    <div class="text-sm text-gray-400 dark:text-gray-500">{exp.location}</div>
                  </div>
                </div>
                <div class="flex-1 text-gray-600 dark:text-gray-400 leading-relaxed">
                  {exp.description}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Education -->
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-xl bg-accent flex items-center justify-center">
            <i class="bi bi-mortarboard text-white"></i>
          </div>
          <h2 class="text-2xl font-extrabold">Education</h2>
        </div>
        <div class="space-y-6">
          {education.map((edu, i) => (
            <div class="reveal card-hover p-6 rounded-2xl bg-white dark:bg-dark-card border border-gray-100 dark:border-dark-border" style={`animation-delay: ${i * 0.1}s`}>
              <div class="flex flex-col md:flex-row gap-6">
                <div class="md:w-48 shrink-0">
                  <div class="bg-gray-50 dark:bg-dark-bg rounded-xl p-4 text-center md:text-left">
                    <div class="text-accent dark:text-accent-light font-bold text-sm">{edu.period}</div>
                    <div class="font-bold mt-2">{edu.degree}</div>
                    <div class="text-sm italic text-gray-500 dark:text-gray-400">{edu.field}</div>
                    <div class="text-sm font-medium mt-1">{edu.school}</div>
                    <div class="text-sm text-gray-400 dark:text-gray-500">{edu.location}</div>
                    {edu.gpa && <div class="text-sm font-bold text-primary dark:text-primary-light mt-1">{edu.gpa}</div>}
                  </div>
                </div>
                <div class="flex-1 text-gray-600 dark:text-gray-400 leading-relaxed">
                  {edu.description}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Technical Skills -->
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center">
            <i class="bi bi-tools text-white"></i>
          </div>
          <h2 class="text-2xl font-extrabold">Technical Skills</h2>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
          {skillGroups.map((group, i) => (
            <div class="reveal card-hover p-5 rounded-2xl bg-white dark:bg-dark-card border border-gray-100 dark:border-dark-border group" style={`animation-delay: ${i * 0.05}s`}>
              <div class="flex items-center gap-3 mb-3">
                <div class="w-9 h-9 rounded-lg bg-primary/10 dark:bg-primary/20 flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-all">
                  <i class={`bi ${group.icon} text-primary dark:text-primary-light group-hover:text-white`}></i>
                </div>
                <h3 class="font-bold text-sm">{group.title}</h3>
              </div>
              <div class="flex flex-wrap gap-1.5">
                {group.skills.map(skill => (
                  <span class="px-2.5 py-1 rounded-lg bg-gray-100 dark:bg-dark-bg text-xs text-gray-600 dark:text-gray-400">{skill}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Projects -->
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center">
            <i class="bi bi-kanban text-white"></i>
          </div>
          <h2 class="text-2xl font-extrabold">Projects</h2>
        </div>
        <div class="space-y-6">
          {projects.map((proj, i) => (
            <div class="reveal card-hover p-6 rounded-2xl bg-white dark:bg-dark-card border border-gray-100 dark:border-dark-border" style={`animation-delay: ${i * 0.1}s`}>
              <div class="flex items-start justify-between mb-2">
                <h3 class="font-bold text-lg">{proj.title}</h3>
                <span class="text-sm text-primary dark:text-primary-light font-semibold shrink-0 ml-4">{proj.period}</span>
              </div>
              <p class="text-gray-600 dark:text-gray-400 mb-3">{proj.description}</p>
              <ul class="space-y-1">
                {proj.bullets.map(bullet => (
                  <li class="flex items-start gap-2 text-sm text-gray-500 dark:text-gray-400">
                    <i class="bi bi-check-circle-fill text-primary dark:text-primary-light text-xs mt-1 shrink-0"></i>
                    {bullet}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Courses & Certifications -->
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-xl bg-accent flex items-center justify-center">
            <i class="bi bi-award text-white"></i>
          </div>
          <h2 class="text-2xl font-extrabold">Courses & Certifications</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          {courses.map((course, i) => (
            <div class="reveal card-hover p-5 rounded-2xl bg-white dark:bg-dark-card border border-gray-100 dark:border-dark-border" style={`animation-delay: ${i * 0.05}s`}>
              <div class="font-bold text-sm mb-1">{course.name}</div>
              <div class="text-sm text-gray-500 dark:text-gray-400">{course.issuer}</div>
              <div class="flex items-center gap-2 mt-2">
                <span class="text-xs text-primary dark:text-primary-light font-semibold">{course.date}</span>
                {course.note && <span class="px-2 py-0.5 rounded-full bg-accent/10 text-accent text-xs font-bold">{course.note}</span>}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Conferences & Workshops -->
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center">
            <i class="bi bi-mic text-white"></i>
          </div>
          <h2 class="text-2xl font-extrabold">Conferences & Workshops</h2>
        </div>
        <div class="space-y-4">
          {conferences.map((conf, i) => (
            <div class="reveal card-hover p-5 rounded-2xl bg-white dark:bg-dark-card border border-gray-100 dark:border-dark-border" style={`animation-delay: ${i * 0.05}s`}>
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div class="font-bold text-sm">{conf.name}</div>
                  <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">{conf.detail}</div>
                </div>
                <span class="text-xs text-primary dark:text-primary-light font-semibold shrink-0">{conf.date}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

<!-- Publications -->
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-xl bg-accent flex items-center justify-center">
            <i class="bi bi-journal-richtext text-white"></i>
          </div>
          <h2 class="text-2xl font-extrabold">Publications</h2>
        </div>
        <div class="reveal card-hover p-6 rounded-2xl bg-white dark:bg-dark-card border border-gray-100 dark:border-dark-border">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
            <div class="flex-1">
              <div class="font-bold text-lg mb-2">Investigating the Protective Effect of Camphene-Conjugated Zinc Oxide Nanoparticles Against Pseudomonas aeruginosa Infection in Danio rerio</div>
              <div class="text-sm text-gray-500 dark:text-gray-400 mb-1">BioNanoScience · Springer · September 2024</div>
              <div class="flex items-center gap-3 flex-wrap mt-2">
                <a href="https://doi.org/10.1007/s12668-024-01561-3" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-sm text-primary dark:text-primary-light hover:underline transition-colors">
                  <i class="bi bi-link-45deg"></i>
                  DOI: 10.1007/s12668-024-01561-3
                </a>
                <button 
                  onclick="navigator.clipboard.writeText('10.1007/s12668-024-01561-3'); this.innerHTML='<i class=\"bi bi-check\"></i> Copied!'; setTimeout(() => this.innerHTML='<i class=\"bi bi-clipboard\"></i> Copy DOI', 2000)"
                  class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-primary/10 text-primary text-xs font-bold hover:bg-primary/20 transition-colors cursor-pointer"
                  title="Copy DOI to clipboard"
                >
                  <i class="bi bi-clipboard"></i> Copy DOI
                </button>
                <span class="px-3 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-bold shrink-0">8 Citations</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Awards -->
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-xl bg-accent flex items-center justify-center">
            <i class="bi bi-trophy text-white"></i>
          </div>
          <h2 class="text-2xl font-extrabold">Awards</h2>
        </div>
        <div class="space-y-4">
          {awards.map((award, i) => (
            <div class="reveal card-hover p-5 rounded-2xl bg-white dark:bg-dark-card border border-gray-100 dark:border-dark-border" style={`animation-delay: ${i * 0.05}s`}>
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div class="font-bold text-sm">{award.title}</div>
                  <div class="text-sm text-gray-500 dark:text-gray-400">{award.org}</div>
                  {award.detail && <div class="text-sm text-gray-400 dark:text-gray-500 mt-1">{award.detail}</div>}
                </div>
                <span class="text-xs text-primary dark:text-primary-light font-semibold shrink-0">{award.date}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Chess -->
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center">
            <i class="bi bi-king text-white"></i>
          </div>
          <h2 class="text-2xl font-extrabold">Chess</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          {chess.map((item, i) => (
            <div class="reveal card-hover p-5 rounded-2xl bg-white dark:bg-dark-card border border-gray-100 dark:border-dark-border" style={`animation-delay: ${i * 0.05}s`}>
              <div class="font-bold text-sm">{item.title}</div>
              <div class="flex items-center gap-2 mt-2">
                <span class="px-2.5 py-1 rounded-lg bg-accent/10 text-accent text-xs font-bold">{item.place}</span>
                <span class="text-xs text-gray-500 dark:text-gray-400">{item.date}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Soft Skills -->
      <section>
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-xl bg-accent flex items-center justify-center">
            <i class="bi bi-heart text-white"></i>
          </div>
          <h2 class="text-2xl font-extrabold">Soft Skills</h2>
        </div>
        <div class="flex flex-wrap gap-3">
          {['Conflict Resolution', 'Time Management', 'Process Optimization & Automation', 'Flexible & Adaptive', 'Listening'].map((skill, i) => (
            <div class="reveal px-5 py-3 rounded-2xl bg-white dark:bg-dark-card border border-gray-100 dark:border-dark-border font-bold text-sm" style={`animation-delay: ${i * 0.05}s`}>
              {skill}
            </div>
          ))}
        </div>
      </section>

      <!-- Referees -->
      <section class="mt-16">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center">
            <i class="bi bi-people text-white"></i>
          </div>
          <h2 class="text-2xl font-extrabold">Referees</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-4">
          <div class="reveal p-5 rounded-2xl bg-white dark:bg-dark-card border border-gray-100 dark:border-dark-border">
            <div class="font-bold text-sm">Dr. Dhanya Narayanan</div>
            <div class="text-sm text-gray-500 dark:text-gray-400">Assistant Professor, ASNSMM, Kochi</div>
            <div class="text-sm text-primary dark:text-primary-light mt-1">dhanyan@aims.amrita.edu</div>
          </div>
          <div class="reveal p-5 rounded-2xl bg-white dark:bg-dark-card border border-gray-100 dark:border-dark-border">
            <div class="font-bold text-sm">Dr. Nafees Ahmad</div>
            <div class="text-sm text-gray-500 dark:text-gray-400">Professor, Immunobiology, UoA, Tucson</div>
            <div class="text-sm text-primary dark:text-primary-light mt-1">nafees@arizona.edu</div>
          </div>
          <div class="reveal p-5 rounded-2xl bg-white dark:bg-dark-card border border-gray-100 dark:border-dark-border">
            <div class="font-bold text-sm">Dr. I. Praveen Kumar</div>
            <div class="text-sm text-gray-500 dark:text-gray-400">Assistant Professor, SIMATS, Chennai</div>
            <div class="text-sm text-primary dark:text-primary-light mt-1">praveenkumarissac@gmail.com</div>
          </div>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
