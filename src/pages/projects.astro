---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const projects = [
  {
    title: 'Master\'s Thesis',
    description: 'A Novel Non-Viral Gene Vector: PBAE based Core-Shell Nanoparticle System for Gene Delivery. Synthesis of PBAE with troubleshooting and optimization approaches. Core-shell system design, cell culture, and GFP-transfection studies.',
    tags: ['PBAE', 'Nanoparticles', 'Gene Delivery', 'Cell Culture'],
    category: 'Research',
    flag: true,
    features: ['PBAE synthesis & optimization', 'Core-shell nanoparticle design', 'GFP-transfection studies', 'In vitro assays'],
  },
  {
    title: 'PathSeq_AMR',
    description: 'Pathogen identification & antimicrobial resistance detection for clinical metagenomic specimens. Takes Illumina paired-end FASTQ files, identifies 30 target pathogens, and detects AMR genes via KMA against ResFinder and CARD databases.',
    tags: ['Python', 'Bowtie2', 'KMA', 'FastAPI', 'Docker'],
    category: 'Bioinformatics',
    flag: true,
    github: 'https://github.com/WeParadox/PathSeq_AMR',
    features: ['30 target organisms', 'ResFinder + CARD', 'Clinical PDF reports', 'Interactive dashboard', 'Docker support'],
  },
  {
    title: 'Bachelor\'s Thesis',
    description: 'Examining the Therapeutic effects of Camphene Conjugated with Zinc Oxide Nanoparticles on Zebrafish Larvae. Published in BioNanoScience with 6 citations.',
    tags: ['Zebrafish', 'Nanoparticles', 'Toxicology', 'BioNanoScience'],
    category: 'Research',
    badge: 'Published',
    features: ['Developmental toxicity studies', 'Neurotoxicity analysis', 'ROS enhancement (GPx/GST)', 'DCFH-DA fluorescent assay'],
  },
  {
    title: 'Ammo Mist',
    description: 'Non-electrode-based IoT module for detecting dissolved ammonia in aquariums. ESP32 transmits data for remote monitoring. Custom 3D-printed housing designed for the sensor.',
    tags: ['ESP32', 'IoT', '3D Printing'],
    category: 'Hardware / IoT',
    badge: 'Patented',
    github: 'https://github.com/WeParadox',
    features: ['Non-electrode detection', 'ESP32 WiFi transmission', 'Custom 3D-printed housing', 'Institutional patent'],
  },
  {
    title: 'Clin Mist',
    description: 'Novel surface disinfectant using antimicrobial properties of terpinen-4-ol extracted from Green tea, creating a natural alternative to sodium hypochlorite.',
    tags: ['Chemistry', 'Product Development'],
    category: 'Research',
    badge: 'Patented',
    features: ['Natural antimicrobial', 'Terpinen-4-ol from Green tea', 'Institutional patent', 'YUKTI Innovation challenge'],
  },
  {
    title: 'Cell Dilution & Seeding Planner',
    description: 'Hemocytometer cell count calculator combined with a seeding planner for 96 well plate assays.',
    tags: ['HTML', 'JavaScript'],
    category: 'Lab Tool',
    github: 'https://github.com/WeParadox/Cell-Dilution-and-Seeding-Planner',
    live: 'https://weparadox.github.io/Cell-Dilution-and-Seeding-Planner/',
    features: ['Hemocytometer calculator', '96 well plate planner', 'One-click calculations'],
  },
  {
    title: 'Well Plate Assay Layout Planner',
    description: 'Automated tool to assign plates with custom samples and controls for experiment planning.',
    tags: ['HTML', 'JavaScript'],
    category: 'Lab Tool',
    github: 'https://github.com/WeParadox/Well-Plate-Assay-Layout-Planner',
    live: 'https://weparadox.github.io/Well-Plate-Assay-Layout-Planner/',
    features: ['Custom sample assignment', 'Control wells', 'Visual plate layout'],
  },
  {
    title: 'N-P Ratio Calculator',
    description: 'Simplified nanoparticle size ratio calculator for quick N/P ratio calculations.',
    tags: ['HTML', 'JavaScript'],
    category: 'Lab Tool',
    github: 'https://github.com/WeParadox/N-P-Ratio-Calculator',
    live: 'https://weparadox.github.io/N-P-Ratio-Calculator/',
    features: ['Instant N/P ratio', 'Clean interface', 'Mobile friendly'],
  },
  {
    title: 'Cell Lines Database',
    description: 'Cell line culture and handling notes database built with MkDocs Material.',
    tags: ['Python', 'MkDocs'],
    category: 'Reference',
    github: 'https://github.com/WeParadox/Cell_Lines',
    features: ['Culture conditions', 'Handling protocols', 'Searchable docs'],
  },
  {
    title: 'Caraoke',
    description: 'Offline Karaoke app for syncing lyrics with songs. Source code developed using AI, APK built with Android Studio.',
    tags: ['TypeScript', 'Gemini API', 'Android'],
    category: 'Side Project',
    github: 'https://github.com/WeParadox/Caraoke',
    features: ['Lyrics sync', 'Offline playback', 'AI-assisted development'],
  },
  {
    title: 'Obsidian Knowledge Base',
    description: 'Personal knowledge management system for coursework. Storyboard layout connecting related notes with a mind map approach.',
    tags: ['Obsidian'],
    category: 'Knowledge',
    features: ['7 subject categories', 'Interactive canvas', 'Cross-linked notes'],
  },
];

const categoryColors: Record<string, string> = {
  'Research': 'bg-purple-500 text-white',
  'Bioinformatics': 'bg-primary text-white',
  'Hardware / IoT': 'bg-emerald-500 text-white',
  'Lab Tool': 'bg-sky-500 text-white',
  'Reference': 'bg-orange-500 text-white',
  'Side Project': 'bg-pink-500 text-white',
  'Knowledge': 'bg-indigo-500 text-white',
};
---

<Layout title="Vikhram Ravi - Projects">
  <Nav />
  <main class="flex-1">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <!-- Header -->
      <div class="text-center mb-16 reveal">
        <h1 class="text-4xl md:text-5xl font-extrabold mb-4">
          <span class="text-gradient">Projects</span>
        </h1>
        <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          Research tools, bioinformatics pipelines, IoT devices, and more. Built to solve real problems in the lab.
        </p>
      </div>

      <!-- Featured Project: Master's Thesis -->
      <div class="mb-12 reveal">
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-purple-500/10 via-white to-primary/10 dark:from-purple-500/20 dark:via-dark-card dark:to-primary/20 border border-purple-500/20 dark:border-purple-500/30 p-8 md:p-10">
          <div class="absolute top-6 right-6">
            <span class="px-3 py-1.5 rounded-full bg-purple-500 text-white text-xs font-bold uppercase tracking-wider">Current</span>
          </div>
          <div class="flex flex-col md:flex-row gap-8">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-4">
                <span class="px-3 py-1 rounded-lg bg-purple-500/10 dark:bg-purple-500/20 text-purple-600 dark:text-purple-400 text-xs font-bold">{projects[0].category}</span>
              </div>
              <h2 class="text-3xl font-extrabold mb-3">{projects[0].title}</h2>
              <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-6">{projects[0].description}</p>
              <div class="grid grid-cols-2 gap-2 mb-6">
                {projects[0].features.map(f => (
                  <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
                    <i class="bi bi-check-circle-fill text-purple-500 text-xs"></i>
                    {f}
                  </div>
                ))}
              </div>
              <div class="flex flex-wrap gap-2">
                {projects[0].tags.map(tag => (
                  <span class="px-3 py-1 rounded-lg bg-gray-100 dark:bg-dark-bg text-xs font-medium text-gray-600 dark:text-gray-400">{tag}</span>
                ))}
              </div>
            </div>
            <div class="md:w-64 shrink-0 flex items-center justify-center">
              <div class="w-full aspect-square rounded-2xl bg-gradient-to-br from-purple-500/20 to-primary/20 dark:from-purple-500/30 dark:to-primary/30 flex flex-col items-center justify-center p-6 text-center">
                <i class="bi bi-capsule text-5xl text-purple-500 mb-3"></i>
                <div class="text-xl font-extrabold">PBAE</div>
                <div class="text-sm text-gray-500 dark:text-gray-400">Core-Shell Nanoparticles</div>
                <div class="w-full h-px bg-gray-200 dark:bg-dark-border my-3"></div>
                <div class="text-xl font-extrabold text-primary dark:text-primary-light">Gene</div>
                <div class="text-sm text-gray-500 dark:text-gray-400">Delivery</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Featured Project: PathSeq_AMR -->
      <div class="mb-12 reveal">
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary/10 via-white to-accent/10 dark:from-primary/20 dark:via-dark-card dark:to-accent/20 border border-primary/20 dark:border-primary/30 p-8 md:p-10">
          <div class="absolute top-6 right-6">
            <span class="px-3 py-1.5 rounded-full bg-primary text-white text-xs font-bold uppercase tracking-wider">Flagship</span>
          </div>
          <div class="flex flex-col md:flex-row gap-8">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-4">
                <span class="px-3 py-1 rounded-lg bg-primary/10 dark:bg-primary/20 text-primary dark:text-primary-light text-xs font-bold">{projects[1].category}</span>
              </div>
              <h2 class="text-3xl font-extrabold mb-3">{projects[1].title}</h2>
              <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-6">{projects[1].description}</p>
              <div class="grid grid-cols-2 gap-2 mb-6">
                {projects[1].features.map(f => (
                  <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
                    <i class="bi bi-check-circle-fill text-primary dark:text-primary-light text-xs"></i>
                    {f}
                  </div>
                ))}
              </div>
              <div class="flex flex-wrap gap-2 mb-6">
                {projects[1].tags.map(tag => (
                  <span class="px-3 py-1 rounded-lg bg-gray-100 dark:bg-dark-bg text-xs font-medium text-gray-600 dark:text-gray-400">{tag}</span>
                ))}
              </div>
              <div class="flex gap-3">
                {projects[1].github && (
                  <a href={projects[1].github} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-bold rounded-xl text-sm hover:opacity-90 transition-opacity">
                    <i class="bi bi-github"></i> Source Code
                  </a>
                )}
              </div>
            </div>
            <div class="md:w-64 shrink-0 flex items-center justify-center">
              <div class="w-full aspect-square rounded-2xl bg-gradient-to-br from-primary/20 to-accent/20 dark:from-primary/30 dark:to-accent/30 flex flex-col items-center justify-center p-6 text-center">
                <i class="bi bi-shield-check text-5xl text-primary dark:text-primary-light mb-3"></i>
                <div class="text-2xl font-extrabold">30</div>
                <div class="text-sm text-gray-500 dark:text-gray-400">Target Organisms</div>
                <div class="w-full h-px bg-gray-200 dark:bg-dark-border my-3"></div>
                <div class="text-2xl font-extrabold text-accent dark:text-accent-light">AMR</div>
                <div class="text-sm text-gray-500 dark:text-gray-400">Gene Detection</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Other Projects Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.slice(2).map((project, i) => (
          <div class="reveal card-hover p-6 rounded-2xl bg-white dark:bg-dark-card border border-gray-100 dark:border-dark-border flex flex-col" style={`animation-delay: ${i * 0.05}s`}>
            <div class="flex items-center justify-between mb-3">
              <span class={`px-2.5 py-1 rounded-lg text-xs font-bold ${categoryColors[project.category] || 'bg-gray-500 text-white'}`}>{project.category}</span>
              {project.badge && (
                <span class={`px-2.5 py-1 rounded-lg text-xs font-bold ${project.badge === 'Patented' ? 'bg-accent/10 dark:bg-accent/20 text-accent dark:text-accent-light' : 'bg-primary/10 dark:bg-primary/20 text-primary dark:text-primary-light'}`}>{project.badge}</span>
              )}
            </div>
            <h3 class="text-lg font-extrabold mb-2">{project.title}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mb-4 flex-1">{project.description}</p>
            <div class="flex flex-wrap gap-1.5 mb-4">
              {project.tags.map(tag => (
                <span class="px-2.5 py-1 rounded-lg bg-gray-100 dark:bg-dark-bg text-xs text-gray-600 dark:text-gray-400">{tag}</span>
              ))}
            </div>
            <div class="flex gap-3">
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener" class="text-sm font-bold text-gray-600 dark:text-gray-400 hover:text-primary dark:hover:text-primary-light transition-colors">
                  <i class="bi bi-github mr-1"></i>Code
                </a>
              )}
              {project.live && (
                <a href={project.live} target="_blank" rel="noopener" class="text-sm font-bold text-gray-600 dark:text-gray-400 hover:text-primary dark:hover:text-primary-light transition-colors">
                  <i class="bi bi-box-arrow-up-right mr-1"></i>Live
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
