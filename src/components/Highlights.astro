---
const highlights = [
  {
    icon: 'bi-journal-richtext',
    label: 'Published',
    title: 'BioNanoScience',
    detail: '6 Citations',
    color: 'primary',
  },
];
---

<section class="py-20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12 reveal">
      <h2 class="text-3xl md:text-4xl font-extrabold">
        Research <span class="text-gradient">Highlights</span>
      </h2>
    </div>
    <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
      {highlights.map((h, i) => (
        <div class={`reveal card-hover p-6 rounded-2xl border ${h.color === 'primary' ? 'border-primary/20 bg-primary/5 dark:bg-primary/10' : 'border-accent/20 bg-accent/5 dark:bg-accent/10'}`} style={`animation-delay: ${i * 0.1}s`}>
          <div class="flex items-start gap-4">
            <div class={`w-12 h-12 rounded-xl flex items-center justify-center shrink-0 ${h.color === 'primary' ? 'bg-primary text-white' : 'bg-accent text-white'}`}>
              <i class={`bi ${h.icon} text-xl`}></i>
            </div>
            <div>
              <div class={`text-xs font-bold uppercase tracking-wider mb-1 ${h.color === 'primary' ? 'text-primary dark:text-primary-light' : 'text-accent dark:text-accent-light'}`}>
                {h.label}
              </div>
              <div class="font-bold text-gray-900 dark:text-gray-100">{h.title}</div>
              <div class="text-sm text-gray-500 dark:text-gray-400">{h.detail}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
