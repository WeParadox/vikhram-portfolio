---
const highlights = [
  {
    icon: 'bi-journal-richtext',
    label: 'Published',
    title: 'BioNanoScience',
    detail: '8 Citations',
    color: 'primary',
    href: '/resume#publications',
  },
  {
    icon: 'bi-mortarboard',
    label: 'Education',
    title: 'Dual Master\'s',
    detail: 'M.Tech (9.48/10) + MS (4/4)',
    color: 'accent',
    href: '/resume#education',
  },
  {
    icon: 'bi-trophy',
    label: 'Achievement',
    title: 'GATE 2026',
    detail: 'Biotechnology Qualified',
    color: 'primary',
    href: '/resume#awards',
  },
  {
    icon: 'bi-award',
    label: 'Honor',
    title: 'Best Outgoing Student',
    detail: '2024 Batch, SIMATS',
    color: 'accent',
    href: '/resume#awards',
  },
  {
    icon: 'bi-dna',
    label: 'PhD Research',
    title: 'ANRF Project',
    detail: 'cfDNA Sepsis Detection',
    color: 'primary',
    href: '/projects',
  },
];
---

<section class="py-20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12 reveal">
      <h2 class="text-3xl md:text-4xl font-extrabold">
        Research <span class="text-gradient">Highlights</span>
      </h2>
    </div>
    <div class="grid md:grid-cols-2 gap-5 max-w-3xl mx-auto">
      {highlights.map((h, i) => (
        <a 
          href={h.href}
          class={`reveal card-hover p-6 rounded-2xl border flex items-start gap-5 transition-all duration-300 hover:shadow-xl ${h.color === 'primary' ? 'border-primary/20 bg-primary/5 dark:bg-primary/10 hover:border-primary/40' : 'border-accent/20 bg-accent/5 dark:bg-accent/10 hover:border-accent/40'}`}
          style={`animation-delay: ${i * 0.08}s`}
        >
          <div class={`w-12 h-12 rounded-xl flex items-center justify-center shrink-0 ${h.color === 'primary' ? 'bg-primary text-white' : 'bg-accent text-white'}`}>
            <i class={`bi ${h.icon} text-xl`}></i>
          </div>
          <div class="flex-1 min-w-0">
            <div class={`text-xs font-bold uppercase tracking-wider mb-1 ${h.color === 'primary' ? 'text-primary dark:text-primary-light' : 'text-accent dark:text-accent-light'}`}>
              {h.label}
            </div>
            <div class="font-bold text-gray-900 dark:text-gray-100 mb-0.5">{h.title}</div>
            <div class="text-sm text-gray-500 dark:text-gray-400">{h.detail}</div>
          </div>
          <i class="bi bi-chevron-right text-gray-400 dark:text-gray-500 shrink-0 transition-transform group-hover:translate-x-1" />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .group:hover .bi-chevron-right {
    transform: translateX(4px);
  }
</style>