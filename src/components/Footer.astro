---
const base = '/vikhram';
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-gray-100 dark:border-dark-border bg-white dark:bg-dark-bg">
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="text-sm text-gray-500 dark:text-gray-400">
        &copy; {year} Vikhram Ravi. Built with Astro & Tailwind CSS.
      </div>
      <div class="flex items-center gap-5">
        <a href="https://linkedin.com/in/ravivikhram" target="_blank" rel="noopener" class="text-gray-400 hover:text-primary dark:hover:text-primary-light transition-colors" aria-label="LinkedIn">
          <i class="bi bi-linkedin text-xl"></i>
        </a>
        <a href="https://github.com/WeParadox" target="_blank" rel="noopener" class="text-gray-400 hover:text-primary dark:hover:text-primary-light transition-colors" aria-label="GitHub">
          <i class="bi bi-github text-xl"></i>
        </a>
        <a href="mailto:vikhramravi2002@gmail.com" class="text-gray-400 hover:text-primary dark:hover:text-primary-light transition-colors" aria-label="Email">
          <i class="bi bi-envelope text-xl"></i>
        </a>
      </div>
    </div>
  </div>
</footer>
